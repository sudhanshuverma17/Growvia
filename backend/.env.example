# ==============================================================================
# Growvia Career Guidance Platform - Environment Configuration Example
# Copy this file to .env in your backend directory and supply real values.
# ==============================================================================

# --- 1. SERVER & RUNTIME ENVIRONMENT ---
PORT=5000
# Allowed frontend origin for CORS and Cashfree payment return_url
# Production: FRONTEND_URL=https://honesvia.com
# Local dev: FRONTEND_URL=http://localhost:3000
FRONTEND_URL=https://honesvia.com
# (Optional alias, supports comma-separated list of origins)
CLIENT_URL=https://honesvia.com,https://www.honesvia.com,https://growvia-6owo.onrender.com
# (Optional public backend URL for webhooks/notify_url, e.g. via domain or ngrok)
BACKEND_URL=https://honesvia.com

# --- 2. DATABASE (MONGODB ATLAS) ---
# Required: Full MongoDB connection URI with credentials and database name
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/growvia?retryWrites=true&w=majority

# --- 3. AUTHENTICATION & SECURITY (JWT) ---
# Required in production: Strong random secret for signing JWTs
# The server refuses to start in production (NODE_ENV=production) without this variable!
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters
JWT_EXPIRES_IN=7d

# --- 4. ADMINISTRATOR ACCOUNT PROVISIONING ---
# Full name for the single seeded administrator account
ADMIN_NAME="Growvia Administrator"
# Email address for the seeded administrator account
ADMIN_EMAIL=admin@growvia.com
# Initial password for the administrator account (used by 'npm run seed:admin')
ADMIN_INITIAL_PASSWORD=your_strong_admin_password_here

# --- 5. AI CAREER ADVISOR (GEMINI LLM) ---
# Google Gemini API key for real-time career consultation chatbot
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# (Optional alternative LLM providers supported by LangChain service)
# LLM_PROVIDER=gemini
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- 6. PAYMENT GATEWAY (CASHFREE) ---
# Cashfree API credentials for roadmap purchasing checkout & webhooks
# Obtain keys from:
# - TEST/Sandbox: https://sandbox.cashfree.com/
# - PRODUCTION/Live: https://merchant.cashfree.com/
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
# Mode: "TEST" (Sandbox) or "PRODUCTION" (Live)
CASHFREE_ENV=TEST

# --- 7. TRANSACTIONAL EMAIL (RESEND) ---
# Resend API Key (Obtain from https://resend.com/api-keys)
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz
# Application URL for password reset links (e.g., https://honesvia.com or http://localhost:3000)
APP_URL=https://honesvia.com
# Verified Sender Email (Use 'onboarding@resend.dev' for sandbox/testing, or your verified domain e.g. 'Honesvia <support@honesvia.com>')
EMAIL_FROM="Honesvia <onboarding@resend.dev>"
