# ==============================================================================
# Growvia Career Guidance Platform - Environment Configuration Example
# Copy this file to .env in your backend directory and supply real values.
# ==============================================================================

# --- 1. SERVER & RUNTIME ENVIRONMENT ---
PORT=5000
NODE_ENV=development
# Allowed frontend origin for CORS
CLIENT_URL=http://localhost:3000

# --- 2. DATABASE (MONGODB ATLAS) ---
# Required: Full MongoDB connection URI with credentials and database name
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/growvia?retryWrites=true&w=majority

# --- 3. AUTHENTICATION & SECURITY (JWT) ---
# Required in production: Strong random secret for signing JWTs
# The server refuses to start in production (NODE_ENV=production) without this variable!
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters
JWT_EXPIRES_IN=7d

# --- 4. ADMINISTRATOR ACCOUNT PROVISIONING ---
# Email address granted Administrator privileges across the platform
ADMIN_EMAIL=admin@growvia.com
# Initial administrator password (required when seeding or first-time setup)
ADMIN_PASSWORD=your_strong_admin_password_here

# --- 5. AI CAREER ADVISOR (GEMINI LLM) ---
# Google Gemini API key for real-time career consultation chatbot
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# (Optional alternative LLM providers supported by LangChain service)
# LLM_PROVIDER=gemini
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- 6. PAYMENT GATEWAY (RAZORPAY) ---
# Razorpay API credentials for roadmap purchasing checkout & webhooks
# Obtain keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
